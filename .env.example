# ================================================================
# 🌿 ŚMIECIARKA – KONFIGURACJA PRODUKCYJNA (SUPABASE & GOOGLE OAUTH)
# Skopiuj ten plik do pliku .env w głównym katalogu projektu:
# cp .env.example .env
# ================================================================

# 1. Supabase (Baza danych PostgreSQL, Storage zdjęć i Uwierzytelnianie)
# Pobierz z: https://supabase.com/dashboard/project/_/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://twoj-projekt.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=twoj-anon-public-key

# 2. Google OAuth (Google Cloud Console)
# Pobierz z: https://console.cloud.google.com/apis/credentials
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=twoj-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=twoj-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=twoj-android-client-id.apps.googleusercontent.com
