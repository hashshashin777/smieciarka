# Supabase Configuration
# Copy this file to .env and fill in real values (never commit .env!)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Google Sign-In OAuth Client IDs (from Google Cloud Console)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# Google Maps API Key for Android (react-native-maps)
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_API_KEY=your-android-maps-api-key

# Public links & Admin security (optional)
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://smieciarka.fun/privacy
EXPO_PUBLIC_TERMS_URL=https://smieciarka.fun/terms
EXPO_PUBLIC_SUPPORT_EMAIL=kontakt@smieciarka.fun
